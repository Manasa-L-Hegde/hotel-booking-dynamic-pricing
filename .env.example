# Database and token signing
# PostgreSQL / Supabase connection:
# e.g. DATABASE_URL=postgresql://postgres:your_password@localhost:5432/hotel_booking
# e.g. DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hotel_booking
JWT_SECRET=replace-with-a-long-random-secret
OTP_HASH_SECRET=replace-with-a-separate-long-random-secret
JWT_EXPIRY=1d

# OTP and active-session policy
OTP_EXPIRY_SECONDS=60
ACTIVE_SESSION_TIMEOUT_MINUTES=30

# SMS provider. "mock" deliberately sends no real SMS.
SMS_PROVIDER=mock
SMS_PROVIDER_API_KEY=
SMS_PROVIDER_API_SECRET=
SMS_PROVIDER_SENDER_ID=
# Only use this for local development to retrieve a mock OTP from the server console.
DEV_OTP_LOGGING=false

# Used only by `npm run seed:admin`; do not commit actual values.
ADMIN_NAME=SmartStay Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password
